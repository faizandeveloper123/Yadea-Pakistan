Options -Indexes

<IfModule mod_headers.c>
  # Never cache HTML so new deploys are picked up immediately
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Long-lived cache for hashed build assets (filenames change per build)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Static images and fonts: short cache
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>